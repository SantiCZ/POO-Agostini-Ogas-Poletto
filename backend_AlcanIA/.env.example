# =====================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =====================================================================
# Copia este archivo como '.env' en este mismo directorio y completa
# los valores con tus credenciales reales de producción.
# =====================================================================

# 1. CREDENCIALES DE LA BASE DE DATOS (MySQL)
MYSQL_ROOT_PASSWORD=tu_contraseña_root_aqui
MYSQL_PASSWORD=tu_contraseña_usuario_aqui

# 2. SEGURIDAD DE FASTAPI / JWT
SECRET_KEY=tu_clave_secreta_para_tokens_jwt_aqui

# 3. INTELIGENCIA ARTIFICIAL (OpenAI GPT API)
OPENAI_API_KEY=tu_openai_api_key_aqui
